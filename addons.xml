<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
    <addon id="repository.pronostici"
           name="Caltiki Repository"
           version="1.0.0"
           provider-name="Caltiki">

      <extension point="xbmc.addon.repository" name="Caltiki Repository">
        <!-- ATTENZIONE: questi tre URL contengono il nome del repository GitHub
             PUBBLICO che ospita i pacchetti. Se il repository si chiama in altro
             modo, o il branch non e' main, gli aggiornamenti non arrivano - e non
             arriva nessun messaggio d'errore, Kodi semplicemente non trova nulla.
             Il repository pubblico contiene SOLO pacchetti: i dati dei pronostici
             restano nel repository privato, raggiunto dall'addon con il token. -->
        <dir>
          <info compressed="false">https://raw.githubusercontent.com/Caltiki/pronostici-repo/main/addons.xml</info>
          <checksum>https://raw.githubusercontent.com/Caltiki/pronostici-repo/main/addons.xml.md5</checksum>
          <datadir zip="true">https://raw.githubusercontent.com/Caltiki/pronostici-repo/main</datadir>
        </dir>
      </extension>

      <extension point="xbmc.addon.metadata">
        <summary lang="it">Repository per Pronostici Calcio</summary>
        <description lang="it">Sorgente degli aggiornamenti automatici di Pronostici Calcio e dei loghi delle squadre. Non contiene dati, solo i pacchetti degli addon.</description>
        <platform>all</platform>
        <assets>
          <icon>icon.png</icon>
        </assets>
        <news>v1.0.0 - Primo rilascio.</news>
      </extension>

    </addon>
    <addon id="resource.images.pronostici"
           name="Pronostici - Loghi squadre"
           version="1.0.0"
           provider-name="Caltiki">

      <requires>
        <import addon="xbmc.python" version="3.0.0"/>
      </requires>

      <!-- Addon di sole risorse: nessun codice, solo immagini e la mappa
           nome-squadra -> file. Sta separato da plugin.video.pronostici per una
           ragione pratica: i loghi pesano 16 MB e cambiano raramente, mentre il
           codice del plugin cambia spesso e pesa poche decine di KB. Tenuti
           insieme, ogni correzione di tre righe costringeva a riscaricare
           16 MB. -->
      <extension point="xbmc.resource.images" type="image"/>

      <extension point="xbmc.addon.metadata">
        <summary lang="it">Loghi delle squadre per Pronostici Calcio</summary>
        <description lang="it">877 loghi di squadre e la mappa dei nomi, usati da Pronostici Calcio per mostrare gli stemmi accanto alle partite. Si aggiorna solo quando vengono aggiunte squadre.</description>
        <platform>all</platform>
        <assets>
          <icon>icon.png</icon>
        </assets>
        <news>v1.0.0 - Primo pacchetto: 877 loghi, 1718 nomi in mappa.</news>
      </extension>

    </addon>
    <addon id="plugin.video.pronostici"
           name="Pronostici Calcio"
           version="1.3.0"
           provider-name="Caltiki">

      <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <!-- I loghi stanno qui: 877 PNG che cambiano raramente, tenuti fuori dal
             plugin per non riscaricare 16 MB a ogni aggiornamento del codice.
             Installando dal repository Kodi la dipendenza viene risolta da sola. -->
        <import addon="resource.images.pronostici" version="1.0.0"/>
      </requires>

      <extension point="xbmc.python.pluginsource"
                 library="default.py">
        <provides>video</provides>
      </extension>

      <extension point="xbmc.addon.metadata">
        <summary lang="it">Pronostici calcio</summary>
        <description lang="it">Statarea, WebPronostici, Consensus e AsianOdds. Richiede un token GitHub da inserire una volta in Impostazioni - GitHub: il repository dei dati e' privato.</description>
        <platform>all</platform>
        <assets>
          <icon>resources/icon.png</icon>
        </assets>
        <news>v1.3.0 - Aggiornamento automatico tramite repository Kodi. Loghi spostati in resource.images.pronostici: il plugin passa da 16 MB a 150 KB. Il token GitHub non e' piu' incluso nel pacchetto e va inserito una volta in Impostazioni - GitHub.</news>
      </extension>

    </addon>
</addons>
