<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
    <addon id="repository.pronostici"
           name="Caltiki Repository"
           version="1.0.3"
           provider-name="Caltiki">

      <extension point="xbmc.addon.repository" name="Caltiki Repository">
        <!-- ATTENZIONE: questi tre URL contengono il nome del repository GitHub
             PUBBLICO che ospita i pacchetti. Se il repository si chiama in altro
             modo, o il branch non e' main, gli aggiornamenti non arrivano - e non
             arriva nessun messaggio d'errore, Kodi semplicemente non trova nulla.
             Su main stanno SOLO i pacchetti. I dati dei pronostici stanno sul
             branch gh-data dello stesso repository, letti dall'addon da
             raw.githubusercontent.com senza autenticazione. Nel privato restano
             gli scraper e il codice che li produce. -->
        <dir>
          <info compressed="false">https://raw.githubusercontent.com/Caltiki/pronostici-repo/main/addons.xml</info>
          <checksum>https://raw.githubusercontent.com/Caltiki/pronostici-repo/main/addons.xml.md5</checksum>
          <datadir zip="true">https://raw.githubusercontent.com/Caltiki/pronostici-repo/main</datadir>
        </dir>
      </extension>

      <extension point="xbmc.addon.metadata">
        <summary lang="it">Repository per Pronostici Calcio</summary>
        <description lang="it">Sorgente degli aggiornamenti automatici di Pronostici Calcio e dei loghi delle squadre.</description>
        <platform>all</platform>
        <assets>
          <icon>icon.png</icon>
        </assets>
        <news>v1.0.3 - Dati su repository pubblico: l'addon non chiede piu' un token.</news>
      </extension>

    </addon>
    <addon id="resource.images.pronostici"
           name="Pronostici - Loghi squadre"
           version="1.0.7"
           provider-name="Caltiki">

      <!-- ATTENZIONE - un addon di risorse NON dipende da xbmc.python (non
           contiene codice) ma da kodi.resource, che e' l'addon di sistema che
           definisce i punti di estensione resource.*. Con la dipendenza
           sbagliata, o con il punto scritto "xbmc.resource.images", Kodi
           rifiuta il pacchetto con "impossibile installare dallo zip". -->
      <requires>
        <import addon="kodi.resource" version="1.0.0"/>
      </requires>

      <!-- Addon di sole risorse: nessun codice, solo immagini e la mappa
           nome-squadra -> file. Sta separato da plugin.video.pronostici per una
           ragione pratica: i loghi pesano 16 MB e cambiano raramente, mentre il
           codice del plugin cambia spesso e pesa poche decine di KB. Tenuti
           insieme, ogni correzione di tre righe costringeva a riscaricare
           16 MB. -->
      <extension point="kodi.resource.images"/>

      <extension point="xbmc.addon.metadata">
        <summary lang="it">Loghi delle squadre per Pronostici Calcio</summary>
        <description lang="it">962 loghi di squadre e la mappa dei nomi, usati da Pronostici Calcio per mostrare gli stemmi accanto alle partite. Si aggiorna solo quando vengono aggiunte squadre.</description>
        <platform>all</platform>
        <assets>
          <icon>icon.png</icon>
        </assets>
        <news>v1.0.7 - MLS: 30 squadre. 962 loghi, 1910 nomi in mappa.</news>
      </extension>

    </addon>
    <addon id="plugin.video.pronostici"
           name="Pronostici Calcio"
           version="1.4.1"
           provider-name="Caltiki">

      <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <!-- I loghi stanno qui: 877 PNG che cambiano raramente, tenuti fuori dal
             plugin per non riscaricare 16 MB a ogni aggiornamento del codice.
             Installando dal repository Kodi la dipendenza viene risolta da sola. -->
        <import addon="resource.images.pronostici" version="1.0.0"/>
      </requires>

      <extension point="xbmc.python.pluginsource"
                 library="default.py">
        <provides>video</provides>
      </extension>

      <extension point="xbmc.addon.metadata">
        <summary lang="it">Pronostici calcio</summary>
        <description lang="it">Statarea, WebPronostici, Consensus e AsianOdds aggiornati ogni giorno. Non serve configurare niente: si installa e funziona.</description>
        <platform>all</platform>
        <assets>
          <icon>resources/icon.png</icon>
        </assets>
        <news>v1.4.1 - Menu ripulito: restano le quattro sorgenti. La voce [Avanzate] e' sparita, perche' non serve a chi usa l'addon; repository e branch restano modificabili dalle Impostazioni di Kodi, dove chi ne ha bisogno li cerca. v1.4.0 - Niente piu' token GitHub: i dati stanno in un repository pubblico e l'addon funziona appena installato.</news>
      </extension>

    </addon>
</addons>
